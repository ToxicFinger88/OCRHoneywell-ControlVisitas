<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtUsuarioLogueado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usuario"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtRolUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Control de Visitas"
                    android:textColor="#1F2937"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="⚙" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Cédula"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtCedula"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fecha nacimiento"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtFecha"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:hint="dd/MM/yyyy"
                android:inputType="date"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Apellido 1"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtApellido1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Apellido 2"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtApellido2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nombre"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Empresa"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtEmpresa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="true"
                android:hint="Empresa del visitante"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Persona a visitar"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtPersonaVisitar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="true"
                android:hint="Nombre de la persona a visitar"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fecha lectura"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:padding="12dp"
                android:textColor="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hora lectura"
                android:textColor="#374151"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtHoraRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:padding="12dp"
                android:textColor="#111827" />

            <Button
                android:id="@+id/btnModoManual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#6B7280"
                android:text="Modo manual"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="#22C55E"
                    android:text="Guardar"
                    android:textColor="#FFFFFF" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:text="Limpiar"
                    android:textColor="#FFFFFF" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnSalir"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DC2626"
                    android:text="Salir"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>

